          "fail": { "log": "屏幕吞掉了你的拳头，又完好如初。", "hp": -1, "stress": 2 }
        },
        {
          "text": "关掉电源，背对它",
          "check": null,
          "success": { "log": "电源键无效。你只能把脸别开。", "stress": 1 }
        }
      ]
    },
