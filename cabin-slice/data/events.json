{
  "events": {
    "foyer_knock": {
      "id": "foyer_knock",
      "title": "门外的敲门声",
      "text": "三下整齐的敲门。你明明刚刚反锁了门。门缝下渗进一点白雾。",
      "once": true,
      "choices": [
        {
          "text": "鼓起勇气开门确认",
          "check": "courage",
          "difficulty": 8,
          "success": { "log": "门外空无一人，门槛上却放着一袋镇定剂。", "gainItem": "sedative", "stress": -1 },
          "fail": { "log": "门猛地撞回，雾气钻进喉咙。", "stress": 2, "hp": -1 }
        },
        {
          "text": "理智地退开，检查门锁",
          "check": "mind",
          "difficulty": 7,
          "success": { "log": "锁完好。你把心神稳住。", "stress": -1 },
          "fail": { "log": "门锁在你眼前自己转了一圈。", "stress": 2 }
        },
        {
          "text": "装作没听见，往屋里走",
          "check": null,
          "success": { "log": "敲门声停了。你知道它只是在等。", "stress": 1 }
        }
      ]
    },
    "living_tv": {
      "id": "living_tv",
      "title": "雪花频道",
